# ============================================================
# 乐享 IM - 环境变量模板
# 使用方法: cp .env.example .env 然后修改所有密码
# 安全警告: 生产环境必须修改所有默认密码
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=ChangeMe_RootPwd_2024!
MYSQL_DATABASE=jim_db
MYSQL_USER=lexiang
MYSQL_PASSWORD=ChangeMe_UserPwd_2024!

# ---------- 域名配置 (Nginx 使用) ----------
# 前端域名 (Cloudflare Pages 托管)
FRONTEND_DOMAIN=app.lexiang.com
# API 域名 (指向服务器, Cloudflare 代理)
API_DOMAIN=api.lexiang.com
# 管理后台域名
ADMIN_DOMAIN=admin.lexiang.com
# WebSocket 域名 (可与 API 同域名)
WS_DOMAIN=ws.lexiang.com

# ---------- 管理员初始密码 (首次部署后立即修改) ----------
ADMIN_DEFAULT_PASSWORD=ChangeMe_AdminPwd_2024!
