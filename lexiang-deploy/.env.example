# ============================================================
# 乐享 IM - 环境变量模板
# 使用方法: cp .env.example .env 然后修改所有密码
# 安全警告: 生产环境必须修改所有默认密码
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=ChangeMe_RootPwd_2024!
MYSQL_DATABASE=jim_db
MYSQL_USER=lexiang
MYSQL_PASSWORD=ChangeMe_UserPwd_2024!

# ---------- MinIO 对象存储 ----------
MINIO_ROOT_USER=lexiang
MINIO_ROOT_PASSWORD=ChangeMe_MinioPwd_2024!
# MinIO 访问域名（Nginx反代，需要配置SSL）
MINIO_API_DOMAIN=minio.yefeng.us.cc
# MinIO Bucket名称（首次启动后需手动创建）
MINIO_BUCKET=lexiang-files

# ---------- 域名配置 (Nginx 使用) ----------
# 前端域名 (Cloudflare Pages 托管)
FRONTEND_DOMAIN=www.lexiangim.com
# API 域名 (指向服务器, 灰云直连)
API_DOMAIN=api.yefeng.us.cc
# 管理后台域名
ADMIN_DOMAIN=admin.yefeng.us.cc
# WebSocket 域名 (可与 API 同域名)
WS_DOMAIN=api.yefeng.us.cc

# ---------- 管理员初始密码 (首次部署后立即修改) ----------
ADMIN_DEFAULT_PASSWORD=ChangeMe_AdminPwd_2024!
